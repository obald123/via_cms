# Composer-managed — rebuilt with `composer install` on each environment.
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Per-environment, contains credentials.
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml

# Uploaded and generated files.
/web/sites/*/files/
/web/sites/*/private/

# Résumés and whistleblower attachments — never committed. See
# web/sites/default/settings.php ($settings['file_private_path']).
/private-files/

# seed/content.json is generated by the frontend repo's
# scripts/export-content.mjs but is tracked deliberately: it is 27 KB of
# public content with no secrets, and having it in the repo means a fresh
# clone can seed itself without a manual file copy.

.DS_Store
Thumbs.db
backups/
